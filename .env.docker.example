# انسخ إلى .env وعدّل القيم قبل: docker compose up -d
# BOTHUB_IMAGE=ghcr.io/YOUR_GITHUB_USERNAME/shakowa:latest
BOTHUB_IMAGE=ghcr.io/kkh95x/shakowa:latest
PORT=3000

MONGODB_DB_NAME=shakwaa
NEXT_PUBLIC_APP_URL=http://localhost:3000

AUTH_SECRET=change-me-to-a-long-random-secret
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
TELEGRAM_WEBHOOK_BASE_URL=https://your-domain.com
TELEGRAM_USE_POLLING=false
GRIDFS_BUCKET=appFiles
TOTP_ISSUER=shakwaa
REQUIRE_2FA_FOR_ADMINS=false

NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@bothub.local
