# Production template — copy to .env.prd and adjust if needed
# Usage: docker compose -f docker-compose.prod.yml --env-file .env.prd up -d

NODE_ENV=production
PORT=3320

MONGODB_DB_NAME=bothub
GRIDFS_BUCKET=appFiles

# Your public app URL (NOT api.telegram.org)
TELEGRAM_WEBHOOK_BASE_URL=https://bothub.mod-syria.org
# Local Bot API container (docker-compose.prod.yml service telegram-bot-api).
# Do NOT set this URL unless that container is running with TELEGRAM_API_ID + TELEGRAM_API_HASH.
# Get them from https://my.telegram.org → API development tools
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_API_BASE_URL=http://telegram-bot-api:8081
TELEGRAM_FILE_TIMEOUT_MS=60000
# If you talk to api.telegram.org directly (no local Bot API), pin a working IPv4:
# TELEGRAM_API_IP=149.154.166.110

